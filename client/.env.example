# Frontend env vars: only the backend URL (all Supabase access goes through the server)
VITE_API_URL=http://localhost:3000/api/v1
# Set automatically by "npm run deploy:floci" (server) for the Floci build, leave them out for local dev:
# VITE_ROUTER=hash   links like index.html#/student/requests (the S3 bucket serves files only)
# VITE_BASE=./       built files load from the bucket's folder
