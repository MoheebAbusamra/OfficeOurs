{
  "info": {
    "name": "OfficeOurs - S2 Requests, FAQ, Notifications, AI",
    "description": "S2 API tests for OfficeOurs. Set the \"password\" variable (Variables tab), start the server (npm run dev), then run the whole collection with the Collection Runner. Folders run in order and share variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup (log in, pick a slot)",
      "description": "Run this folder first. It logs in the 3 test accounts and saves their tokens and a bookable slot into the collection variables.",
      "item": [
        {
          "name": "Register I-1002 (ok if already registered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"universityId\": \"{{otherInstructorId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of 201, 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in student 241339",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"universityId\": \"{{studentId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('studentToken', pm.response.json().data.token);",
                  "pm.collectionVariables.set('runTag', String(Date.now())); // makes this run's request title unique"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in instructor I-1001",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"universityId\": \"{{instructorId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('instructorToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in instructor I-1002",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"universityId\": \"{{otherInstructorId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('otherToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "My active requests (slots to avoid)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/requests?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const busy = pm.response.json().data.filter(r => ['pending', 'confirmed'].includes(r.status)).map(r => r.slot.id);",
                  "pm.collectionVariables.set('busySlots', JSON.stringify(busy));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pick a bookable slot of I-1001",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/slots?instructorId={{instructorId}}&limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const today = new Date().toLocaleDateString('en-CA');",
                  "const busy = JSON.parse(pm.collectionVariables.get('busySlots') || '[]');",
                  "const slot = pm.response.json().data.find(s => !s.isFull && s.status === 'active' && s.slotDate > today && !busy.includes(s.id));",
                  "pm.test('Found a bookable slot', () => pm.expect(slot).to.not.be.undefined);",
                  "const plus = (t, m) => { const x = +t.slice(0, 2) * 60 + +t.slice(3, 5) + m; return String(Math.floor(x / 60)).padStart(2, '0') + ':' + String(x % 60).padStart(2, '0'); };",
                  "pm.collectionVariables.set('slotId', slot.id);",
                  "pm.collectionVariables.set('winStart', slot.startTime);",
                  "pm.collectionVariables.set('winEnd', plus(slot.startTime, 10));",
                  "pm.collectionVariables.set('outStart', slot.endTime);",
                  "pm.collectionVariables.set('outEnd', plus(slot.endTime, 15));"
                ]
              }
            }
          ]
        }
      ]
    },
