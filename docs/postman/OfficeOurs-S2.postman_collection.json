          "name": "Inbox: confirmed on this slot",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              }
            ],
            "url": "{{baseUrl}}/requests?status=confirmed&slotId={{slotId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Our request is listed', () => pm.expect(pm.response.json().data.map(r => r.id)).to.include(pm.collectionVariables.get('requestId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Notifications",
      "description": "The bell: list, unread count, mark as read.",
      "item": [
        {
          "name": "Instructor got \"request_created\"",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              }
            ],
            "url": "{{baseUrl}}/notifications?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const tag = pm.collectionVariables.get('runTag');",
                  "const n = pm.response.json().data.find(x => x.type === 'request_created' && x.message.includes(tag));",
                  "pm.test('Notification exists', () => pm.expect(n).to.not.be.undefined);",
                  "pm.test('Has an unread count', () => pm.expect(pm.response.json().meta.unreadCount).to.be.a('number'));",
                  "if (n) pm.collectionVariables.set('notificationId', n.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Student marks it as read -> 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Instructor marks it as read -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              }
            ],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('isRead is true', () => pm.expect(pm.response.json().data.isRead).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark all as read -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              }
            ],
            "url": "{{baseUrl}}/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. AI (Gemini)",
      "description": "Gemini is an outside service: 502 AI_UNAVAILABLE is a correct answer when it is busy.",
      "item": [
        {
          "name": "FAQ check -> verdict (or 502)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests/faq-check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"title\": \"Lab report submission\",\n  \"description\": \"Where do we submit the lab report, and in which format?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of 200, 502', () => pm.expect([200, 502]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('Verdict is valid', () => pm.expect(['answered', 'partial', 'none']).to.include(pm.response.json().data.verdict));"
                ]
              }
            }
          ]
        },
        {
          "name": "FAQ ideas -> list (or 502)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/faqs/suggest",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is one of 200, 502', () => pm.expect([200, 502]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('Returns a list', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
