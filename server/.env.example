# Backend env vars: copy to .env, never commit .env
PORT=3000
CLIENT_URL=http://localhost:5173

# Supabase: Settings > API Keys > secret key (sb_secret_...), server only, never in the frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_placeholder

# External APIs (placeholders for now)
GEMINI_API_KEY=placeholder
CALENDARIFIC_API_KEY=placeholder
BREVO_API_KEY=placeholder
BREVO_SENDER_EMAIL=placeholder@example.com
