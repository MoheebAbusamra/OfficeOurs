# Backend env vars: copy to .env, never commit .env
PORT=3000
CLIENT_URL=http://localhost:5173

# Supabase: Settings > API Keys > secret key (sb_secret_...), server only, never in the frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_placeholder

# External APIs (placeholders for now)
GEMINI_API_KEY=placeholder
# Gemini model (optional, this is the default)
GEMINI_MODEL=gemini-3.5-flash-lite
CALENDARIFIC_API_KEY=placeholder
BREVO_API_KEY=placeholder
BREVO_SENDER_EMAIL=placeholder@example.com
BREVO_SENDER_NAME=OfficeOurs

# [S3] Queue, QR & History
# Public frontend URL the QR code opens (/check-in/<token>); defaults to CLIENT_URL
CHECKIN_BASE_URL=
APP_TIMEZONE=Africa/Cairo

# [S3] Floci (docker compose up -d, then npm run floci:setup --prefix server prints these values)
# Leave AWS_ENDPOINT_URL empty to run without Floci: QR upload, SES copy and the SQS consumer are then skipped
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=officeours-qr
SQS_QUEUE_URL=
QUEUE_LAMBDA_NAME=officeours-queue-worker
SES_SENDER_EMAIL=no-reply@officeours.test
