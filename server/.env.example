# Backend env vars: copy to .env, never commit .env
PORT=3000
CLIENT_URL=http://localhost:5173

# Jest tests (they call the running backend): password of the test accounts 241339, 248690, I-1001, I-1002
TEST_PASSWORD=
# Optional: student the requests tests submit as (gets the real QR email on confirm). Defaults: 241339 + TEST_PASSWORD
TEST_STUDENT_ID=
TEST_STUDENT_PASSWORD=

# Supabase: Settings > API Keys > secret key (sb_secret_...), server only, never in the frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_placeholder

# External APIs (placeholders for now)
GEMINI_API_KEY=placeholder
# Gemini model (optional, this is the default)
GEMINI_MODEL=gemini-3.5-flash-lite
CALENDARIFIC_API_KEY=placeholder
BREVO_API_KEY=placeholder
BREVO_SENDER_EMAIL=placeholder@example.com
BREVO_SENDER_NAME=OfficeOurs


CHECKIN_BASE_URL=
APP_TIMEZONE=Africa/Cairo


AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=officeours-qr
SQS_QUEUE_URL=
QUEUE_LAMBDA_NAME=officeours-queue-worker
SES_SENDER_EMAIL=no-reply@officeours.test


SNS_TOPIC_ARN=
# S3 bucket for the AI log (one JSON file per Gemini call); empty = no AI log
AI_LOG_BUCKET=officeours-ai-log
